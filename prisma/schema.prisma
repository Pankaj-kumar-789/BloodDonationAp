generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  DONOR
  HOSPITAL
  BLOOD_BANK
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum DonationType {
  BLOOD
  PLATELETS
  PLASMA
}

enum RequestStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DriveStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  phone         String?
  role          Role      @default(USER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  donorProfile      DonorProfile?
  hospitalProfile   HospitalProfile?
  bloodBankProfile  BloodBankProfile?

  createdRequests   BloodRequest[]    @relation("CreatedRequests")
  acceptedRequests  BloodRequest[]    @relation("AcceptedRequests")
  
  contactUnlocks    ContactUnlock[]   @relation("UnlockedByUser")
  transactions      Transaction[]
  notifications     Notification[]
  sentMessages      Message[]
  chatRooms         ChatRoom[]        @relation("ChatRoomUsers")
  reviewsGiven      Review[]          @relation("ReviewsGiven")
  reviewsReceived   Review[]          @relation("ReviewsReceived")
}

model DonorProfile {
  id              String     @id @default(cuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodGroup      BloodGroup
  city            String
  state           String
  locationLat     Float?
  locationLng     Float?
  isAvailable     Boolean    @default(true)
  lastDonation    DateTime?
  contactFee      Float      @default(0.0) // Additional fee set by donor
  isVerified      Boolean    @default(false)
  rating          Float      @default(0.0)
  donationTypes   DonationType[] @default([BLOOD])
  
  donationHistory DonationHistory[]
  contactUnlocks  ContactUnlock[]   @relation("DonorContactUnlocked")
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model HospitalProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city        String
  state       String
  isVerified  Boolean  @default(false)
  inventory   HospitalInventory[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BloodBankProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city        String
  state       String
  isVerified  Boolean  @default(false)
  inventory   BloodInventory[]
  donationDrives DonationDrive[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BloodInventory {
  id           String           @id @default(cuid())
  bloodBankId  String
  bloodBank    BloodBankProfile @relation(fields: [bloodBankId], references: [id], onDelete: Cascade)
  bloodGroup   BloodGroup
  donationType DonationType @default(BLOOD)
  units        Int              @default(0)
  updatedAt    DateTime         @updatedAt
  
  @@unique([bloodBankId, bloodGroup, donationType])
}

model HospitalInventory {
  id           String           @id @default(cuid())
  hospitalId   String
  hospital     HospitalProfile  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bloodGroup   BloodGroup
  donationType DonationType @default(BLOOD)
  units        Int              @default(0)
  updatedAt    DateTime         @updatedAt
  
  @@unique([hospitalId, bloodGroup, donationType])
}

model BloodRequest {
  id              String        @id @default(cuid())
  patientName     String
  bloodGroup      BloodGroup
  units           Int
  hospital        String
  city            String
  contactNumber   String
  description     String?
  requiredBefore  DateTime
  isEmergency     Boolean       @default(false)
  status          RequestStatus @default(PENDING)
  donationType    DonationType  @default(BLOOD)
  
  creatorId       String
  creator         User          @relation("CreatedRequests", fields: [creatorId], references: [id])
  
  acceptedById    String?
  acceptedBy      User?         @relation("AcceptedRequests", fields: [acceptedById], references: [id])
  isContactUnlocked Boolean     @default(false)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model DonationHistory {
  id            String       @id @default(cuid())
  donorId       String
  donor         DonorProfile @relation(fields: [donorId], references: [id])
  date          DateTime
  hospital      String
  units         Int
  donationType  DonationType @default(BLOOD)
  createdAt     DateTime     @default(now())
}

model DonationDrive {
  id            String    @id @default(cuid())
  bloodBankId   String
  bloodBank     BloodBankProfile @relation(fields: [bloodBankId], references: [id], onDelete: Cascade)
  name          String
  date          DateTime
  location      String
  city          String
  status        DriveStatus @default(UPCOMING)
  expectedDonors Int?
  unitsCollected Int      @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Transaction {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  amount          Float
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  stripeSessionId String?       @unique
  type            String        // "CONTACT_UNLOCK"
  createdAt       DateTime      @default(now())
}

model ContactUnlock {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation("UnlockedByUser", fields: [userId], references: [id])
  donorId     String
  donor       DonorProfile @relation("DonorContactUnlocked", fields: [donorId], references: [id])
  unlockedAt  DateTime     @default(now())
  
  @@unique([userId, donorId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ChatRoom {
  id        String    @id @default(cuid())
  users     User[]    @relation("ChatRoomUsers")
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id         String   @id @default(cuid())
  content    String
  roomId     String
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Review {
  id          String   @id @default(cuid())
  rating      Int
  comment     String?
  reviewerId  String
  reviewer    User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewedId  String
  reviewed    User     @relation("ReviewsReceived", fields: [reviewedId], references: [id])
  createdAt   DateTime @default(now())
}
